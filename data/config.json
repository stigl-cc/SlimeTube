{
    "listeners": [
        { "address": "0.0.0.0", "port": 8080, "https": false },
        { "address": "0.0.0.0", "port": 8081, "https": true, "use_old_tls": true },
    ],

    "db_clients": [
        {
            "name": "default",
            "rdbms": "sqlite3",
            "filename":"data/database.db",
            "connection_number": 1,
        }
    ],

    "app": {
        "number_of_threads": 4,

        "run_as_daemon": false,
        "handle_sig_term": true,
        "relaunch_on_error": false,

        "log": {
            "log_path": "",
            "logfile_base_name": "",
            "log_size_limit": 1000000,
            "log_level": "DEBUG",
            "display_local_time" : false,
        },
    },

    "custom_config": {
        "title" : "SlimeTube",
        "zero_range_limit" : 10485760,
        "videos_dir" : "./data/videos",
        "thumbnails_dir" : "./data/thumbnails",
        "blobs_dir" : "./data/blobs",
        "salt_length": 16,
        "ffmpeg_log": "data/ffmpeg.log",
        "ffmpeg_log_level": 32,
        "limits" : {
            "max_blob_size": -1,
            "total_user_size": -1,
            "max_get_video_range_size": 10485760,

            "max_aspect_ratio": 5.000,
            "max_input_video_width": 4096,
            "max_input_video_height": 4096,
            "max_encode_video_width": 1920,
            "max_encode_video_height": 1920,
        },

        "video_ratios" : [
            {
                "ratio": [16, 9],
                "resolutions": [
                    [ 1920, 1080, 30, 3150000, [720, 360, 144] ],
                    [ 1280,  720, 30, 1400000, [360, 144] ],
                    [  640,  360, 60,  400000, [144] ],
                    [  256,  144, 60,  100000, [] ],
                ],
            },
            {
                "ratio": [16, 10],
                "resolutions" : [
                    [ 1920, 1200, 30, 3250000, [900, 500] ],
                    [ 1440,  900, 30, 2000000, [500] ],
                    [ 1280,  800, 30, 1500000, [] ],
                    [  800,  500, 60,  600000, [] ],
                ],
            }
            {
                "ratio": [4, 3],
                "resolutions": [
                    [ 1600, 1200, 30, 3120000, [600, 480, 360, 120] ],
                    [ 1024,  768, 30, 1200000, [480, 240, 120] ],
                    [  800,  600, 60,  720000, [360, 120] ],
                    [  640,  480, 60,  460000, [240] ],
                    [  480,  360, 60,  250000, [120] ],
                    [  320,  240, 60,  120000, [] ],
                    [  160,  120, 60,   30000, [] ],
                ],
            },
            {
                "ratio": [3, 2],
                "resolutions": [
                    [ 1620, 1080, 30, 2700000, [720, 480, 200] ],
                    [ 1080,  720, 30, 1100000, [480, 200] ],
                    [  720,  480, 60,  525000, [200] ],
                    [  300,  200, 60,   90000, [] ],
                ],
            },
            {
                "ratio": [1, 1],
                "resolutions": [
                    [ 1080, 1080, 30, 1800000, [512, 256, 128] ],
                    [  640,  640, 60,  625000, [256, 128] ],
                    [  512,  512, 60,  400000, [256, 128] ],
                    [  256,  256, 60,  100000, [] ],
                    [  128,  128, 60,   25000, [] ],
                ],
            },
        ],
    },

    "ssl": {
        "cert": "data/certs/server.crt",
        "key": "data/certs/server.key",
    },

    "plugins": [
        {
            "name": "drogon::plugin::AccessLogger",
            "dependencies": [],
            "config": {
                "use_spdlog": false,
                "log_path": "",
                "log_format": "$request_date $remote_addr $method $url\t$status\t[$request_len/$response_len] $processing_time - '$http_User-Agent'",
                "log_file": "access.log",
                "log_size_limit": 0,
                "use_local_time": false,
                "show_microseconds": false,
                "log_index": 0,
                "custom_time_format": "%Y/%m/%d %H:%M:%S",
                "use_real_ip": true,
            },
        },
    ],
}
