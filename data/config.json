{
    "listeners": [
        { "address": "0.0.0.0", "port": 8080, "https": false },
        { "address": "0.0.0.0", "port": 8443, "https": true, "use_old_tls": true },
        { "address": "::", "port": 8080, "https": false },
        { "address": "::", "port": 8443, "https": true, "use_old_tls": true },
    ],

    "db_clients": [
        {
            "name": "default",
            "rdbms": "sqlite3",
            "filename":"data/database.db",
            "connection_number": 1,
        }
    ],

    "app": {
        "number_of_threads": 4,

        "run_as_daemon": false,
        "handle_sig_term": true,
        "relaunch_on_error": false,

        "log": {
            "log_path": "",
            "logfile_base_name": "",
            "log_size_limit": 1000000,
            "log_level": "DEBUG",
            "display_local_time" : false,
        },
    },

    "custom_config": {
        "title" : "SlimeTube",
        "zero_range_limit" : 10485760,
        "videos_dir" : "./data/videos",
        "thumbnails_dir" : "./data/thumbnails",
        "blobs_dir" : "./data/blobs",
        "salt_length": 16,
        "ffmpeg_log": "data/ffmpeg.log",
        "ffmpeg_log_level": 32,
        "limits" : {
            "max_blob_size": -1,
            "total_user_size": -1,
            "max_get_video_range_size": 10485760,

            "max_unlisted_bitrate": 3150000,
            "max_aspect_ratio": 5.000,
            "max_input_video_width": 4096,
            "max_input_video_height": 4096,
            "max_encode_video_width": 1920,
            "max_encode_video_height": 1920,
        },

        "resolutions": [
            [ [16, 9], 1920, 1080, 3150000, [720, 360, 144] ],
            [ [16, 9], 1280,  720, 1400000, [360, 144] ],
            [ [16, 9],  640,  360,  400000, [144] ],
            [ [16, 9],  256,  144,  100000, [] ],

            [ [16, 10], 1920, 1200, 3250000, [900, 500] ],
            [ [16, 10], 1440,  900, 2000000, [500] ],
            [ [16, 10], 1280,  800, 1500000, [] ],
            [ [16, 10],  800,  500,  600000, [] ],

            [ [4, 3], 1600, 1200, 3120000, [600, 480, 360, 120] ],
            [ [4, 3], 1024,  768, 1200000, [480, 240, 120] ],
            [ [4, 3],  800,  600,  720000, [360, 120] ],
            [ [4, 3],  640,  480,  460000, [240] ],
            [ [4, 3],  480,  360,  250000, [120] ],
            [ [4, 3],  320,  240,  120000, [] ],
            [ [4, 3],  160,  120,   30000, [] ],

            [ [3, 2], 1620, 1080, 2700000, [720, 480, 200] ],
            [ [3, 2], 1080,  720, 1100000, [480, 200] ],
            [ [3, 2],  720,  480,  525000, [200] ],
            [ [3, 2],  300,  200,   90000, [] ],

            [ [1, 1], 1080, 1080, 1800000, [512, 256, 128] ],
            [ [1, 1],  640,  640,  625000, [256, 128] ],
            [ [1, 1],  512,  512,  400000, [256, 128] ],
            [ [1, 1],  256,  256,  100000, [] ],
            [ [1, 1],  128,  128,   25000, [] ],
        ],

        "thumbnail_width" : 640,
        "thumbnail_height" : 360,

        "allow_unlisted_ratios" : true,
        "encoder_frame_rate": 30,

        "audio_bitrate": 128000,
        "audio_sample_rate": 48000,
    },

    "ssl": {
        "cert": "data/certs/server.crt",
        "key": "data/certs/server.key",
    },

    "plugins": [
        {
            "name": "drogon::plugin::AccessLogger",
            "dependencies": [],
            "config": {
                "use_spdlog": false,
                "log_path": "",
                "log_format": "$request_date $remote_addr $method $status [$request_len/$response_len] $processing_time\t $url\t - '$http_User-Agent'",
                "log_file": "access.log",
                "log_size_limit": 0,
                "use_local_time": false,
                "show_microseconds": false,
                "log_index": 0,
                "custom_time_format": "%Y/%m/%d %H:%M:%S",
                "use_real_ip": true,
            },
        },
    ],
}
