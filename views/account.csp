<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>[[title]] - Account</title>
        <link rel="stylesheet" type="text/css" href="/styles.css">
        <link rel="stylesheet" type="text/css" href="/account.css">
    </head>
    <body>
        <%view navbar %>
        <div id="logged-in-container">
            <div id="logged-in-text">
                <div id="logged-in-as-text">Logged in as:</div>
                <div id="username">[[user_name]]([[user_id]])</div>
                <form method="post" action="/logout" id="logout-form">
                    <input id="logout-form-logout" type="submit" value="logout">
                </form>
            </div>

            <div id="change-details" class="account-container">
                <div id="change-details-text">Change User Details</div>
                <form class="user-change" method="post" action="/user/name">
                    <label for="user">username:</label>
                    <input class="user-change-input" id="user-input" name="new_name" type="text" />
                    <input class="user-change-submit" id="new-name-submit" type="submit" value="change username" />
                </form>

                <form class="user-change" method="post" action="/user/password">
                    <label for="user">password:</label>
                    <input class="user-change-input" id="pass-input" name="new_pass" type="password" />
                    <input class="user-change-submit" id="new-pass-submit" type="submit" value="change password" />
                </form>
            </div>

            <div id="videos" class="account-container">
                <a id="upload-link" href="/create">create</a>
                <div id="videos-text">Videos</div>
                <%c++
                    auto videos = @@.get<std::vector<std::unordered_map<std::string, std::string>>>("videos");
                    if(!videos.empty()) { %>
                <table id="videos-table">
                    <colgroup>
                        <col width="8ch">
                        <col width="30ch">
                        <col width="30ch">
                        <col width="10ch">
                        <col width="5ch">
                    </colgroup>
                    <tr>
                        <th>id</th>
                        <th>title</th>
                        <th>description</th>
                        <th>size</th>
                        <th>edit</th>
                    </tr>
                    <%c++
                        for(const auto& video : videos) {%>
                    <tr class="video-table-{%video.at("state")%}">
                        <td>{%video.at("id")%}</td>
                        <td>{%video.at("title")%}</td>
                        <td>{%video.at("description")%}</td>
                        <td>{%video.at("size")%}</td>
                        <td><a href="/video/{%video.at("id")%}/edit">edit</td>
                    </tr>
                    <%c++ }
                    } else {
                    %>
                    <div>User has no videos.</div>
                    <%c++ } %>
                </table>
            </div>
        </div>
        <%view footer %>
    </body>
</html>
