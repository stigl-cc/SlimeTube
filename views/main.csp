<%inc #include <models/Preview.h> %>
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="description" content="Home page for [[title]].">
        <meta name="keywords" content="video, share, video camera, phone camera, open source">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>[[title]]</title>

        <meta property="og:type" content="video.other" />
        <meta property="og:title" content="[[title]]" />
        <meta property="og:description" content="Home page for [[title]]." />
        <meta property="og:url" content="[[url]]/" />
        <meta property="og:image" content="[[url]]/favicon.ico" />
        <meta property="og:site_name" content="[[title]]" />

        <link rel="stylesheet" type="text/css" href="/styles.css">
        <link rel="stylesheet" type="text/css" href="/index.css">
    </head>
    <body>
        <%view navbar %>
        <div id="main-content">
            <%c++
                const std::vector<SlimyTube::Preview>& previews = @@.get<std::vector<SlimyTube::Preview>>("previews");
                for(const SlimyTube::Preview& preview : previews) {%>
            <a class="preview-link" href="/watch/{%preview.id%}">
                <div class="preview">
                    <div class="preview-image-container">
                        <img class="preview-image" src="/rsc/thumbnail/{%preview.id%}">
                        <%c++ if(!preview.length.empty()) {%>
                            <div class="preview-text preview-length">{%preview.length%}</div>
                        <%c++ }%>
                    </div>
                    <div class="preview-text preview-title" title="{%preview.title%}">{%preview.title%}</div>
                    <div class="preview-text preview-channel" title="{%preview.channel%}">{%preview.channel%}</div>
                    <div class="preview-text preview-stats">{%preview.views%} views {%preview.age%} ago </div>
                </div>
            </a>
            <%c++ } if(previews.empty()) { %> <div class="centered-message">No videos to show.</div> <%c++ } %>
        </div>
        <%view footer %>
    </body>
</html>
