<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>[[title]] - [[error-code]] [[error-text]]</title>
        <link rel="stylesheet" type="text/css" href="/styles.css">
    </head>
    <body>
        <%view navbar %>
        <div id="error-content">
            <h1>[[error-code]] [[error-text]]</h1>
            <a id="error-goback" href="[[back]]">go back</a>
        </div>
        <%view footer %>
    </body>
</html>
