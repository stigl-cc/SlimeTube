<%inc #include <models/Preview.h> %>
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="description" content="Found [[result_count]] search results for '[[search_query]]' on [[title]].">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>Searching [[search_query]] - [[title]]</title>
        <link rel="stylesheet" type="text/css" href="/styles.css">
        <link rel="stylesheet" type="text/css" href="/search.css">
    </head>
    <body>
        <%view navbar %>
        <div id="main-content">
            <div>Found [[result_count]] search results for: "[[search_query]]"</div>
            <div>
                <label for="channel-results">Channels:</label>
                <div id="channel-results">
                    <%c++
                        const std::vector<SlimyTube::Channel>& channels = @@.get<std::vector<SlimyTube::Channel>>("channels");
                        for(const SlimyTube::Channel& channel : channels) { %>
                    <a class="channel-link" href="/channel/{%channel.id%}">{%channel.name%}</a> - {%channel.total_views%} total views - {%channel.total_videos%} videos<br>
                    <%c++ } if(channels.empty()) { %>
                    No channels found.
                    <%c++ } %>
                </div>
                <br />
                <label for="video-results">Videos:</label>
                <div id="video-results">
                    <%c++
                        const std::vector<SlimyTube::Preview>& previews = @@.get<std::vector<SlimyTube::Preview>>("previews");
                        for(const SlimyTube::Preview& preview : previews) { %>
                    <a class="preview-link" href="/watch/{%preview.id%}">
                        <div class="preview">
                            <div class="preview-image-container">
                                <img class="preview-image" src="/rsc/thumbnail/{%preview.id%}">
                                <%c++ if(!preview.length.empty()) {%>
                                <div class="preview-text preview-length">{%preview.length%}</div>
                                <%c++ }%>
                            </div>
                            <div class="preview-text-container">
                                <div class="preview-text preview-title">{%preview.title%}</div>
                                <div class="preview-text preview-channel">{%preview.channel%}</div>
                                <div class="preview-text preview-stats">{%preview.views%} views {%preview.age%} ago </div>
                            </div>
                        </div>
                    </a>
                    <%c++ } if(previews.empty()) { %>
                    No videos found.
                    <%c++ } %>
                </div>
            </div>
        </div>
        <%view footer %>
    </body>
</html>
