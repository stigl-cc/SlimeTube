<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>[[title]] - [[video_title]]</title>
        <link rel="stylesheet" type="text/css" href="/styles.css">
        <link rel="stylesheet" type="text/css" href="/watch.css">
    </head>
    <body>
        <%view navbar %>
        <div id="main-content">
            <div id="left-section">
                <video
                    id="video-element"
                    poster="/thumbnail/[[video_id]]"
                    controls>

                    <source src="/video/[[video_id]]" type="video/mp4" />
                    !the video tag is unsupported on this browser!
                </video>

                <div id="video-info-section">
                    <div id="video-title">[[video_title]]</div>
                    <div id="video-statline">
                        <div class="video-stat" id="video-views">[[video_views]] views</div>
                        <div class="video-stat" id="video-age">[[video_age]] ago</div>
                        <a class="video-stat" id="video-channel" href="/channel/[[video_channel_id]]">[[video_channel_name]]</a>
                    </div>
                    <hr>
                    <div id="video-description">[[video_description]]</div>
                </div>

                <div id="video-controls">
                    <label for="quality-selector">Quality:</label>
                    <select onchange= "change_playback_quality()" id="quality-selector">
                        <option value="720">720p</option>
                        <option value="1080">1080p</option>
                    </select>

                    <label for="speed-selector">Speed:</label>
                    <select onchange="change_playback_speed()" id="speed-selector">
                        <option value="0.25">0.25x</option>
                        <option value="0.50">0.50x</option>
                        <option selected="selected" value="1.00">1.00x</option>
                        <option value="1.50">1.50x</option>
                        <option value="2.00">2.00x</option>
                    </select>
                </div>
            </div>

            <div id="right-section">
                <%c++
                    auto previews = @@.get<std::vector<std::unordered_map<std::string, std::string>>>("previews");
                    for(const auto& preview : previews) {%>
                <a class="preview-link" href="/watch/{%preview.at("id")%}">
                    <div class="preview">
                        <div class="preview-image-container">
                            <img class="preview-image" src="/thumbnail/{%preview.at("id")%}">
                            <div class="preview-text preview-length">{%preview.at("length")%}</div>
                        </div>
                        <div class="preview-text preview-title">{%preview.at("title")%}</div>
                        <div class="preview-text preview-channel">{%preview.at("channel")%}</div>
                        <div class="preview-text preview-stats">{%preview.at("views")%} views {%preview.at("age")%} ago </div>
                    </div>
                </a>
                <%c++ }%>
            </div>
        </div>
        <%view footer %>
        <script src="/script.js"></script>
        <script src="/watch.js"></script>
    </body>
</html>
