<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>[[title]] - Account</title>
        <link rel="stylesheet" type="text/css" href="/styles.css">
        <link rel="stylesheet" type="text/css" href="/upload.css">
    </head>
    <body>
        <%view navbar %>
        <div id="create-container">
            <form id="create-form">
                <div id="create-text">Create new video</div>
                <label for="title-entry">Title</label>
                <input id="title-entry" type="text" />

                <label for="description-entry">Description</label>
                <textarea id="description-entry" rows="5"></textarea>

                <input id="video-submit" type="submit" value="Create Video" />
            </form>
        </div>
        <%view footer %>
    </body>
</html>
