<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>[[title]] - Account</title>
        <link rel="stylesheet" type="text/css" href="/styles.css">
        <link rel="stylesheet" type="text/css" href="/upload.css">
    </head>
    <body>
        <%view navbar %>
        <div class="create-upload-container">
            <form method="post" action="/video" class="create-upload-form" id="create-form">
                <div class="create-upload-text">Create new video</div>
                <div class="labeled-entry">
                    <label for="title-entry">
                        title<div class="form-required">*</div>
                    </label>
                    <input id="title-entry" name="title" type="text" />
                </div>

                <div class="labeled-entry">
                    <label for="description-entry">description</label>
                    <textarea id="description-entry" name="desc" rows="5"></textarea>
                </div>

                <input id="video-submit" type="submit" value="Create Video" />
            </form>
        </div>
        <%view footer %>
    </body>
</html>
