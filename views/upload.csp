<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>[[title]] - Account</title>
        <link rel="stylesheet" type="text/css" href="/styles.css">
        <link rel="stylesheet" type="text/css" href="/upload.css">
    </head>
    <body>
        <%view navbar %>
        <div class="create-upload-container">
            <form class="create-upload-form">
                <div class="create-upload-text">Upload assets for video</div>

                <div class="labeled-entry">
                    <label for="title-entry">title</label><br>
                    <input id="title-entry" type="text" value="[[video_title]]" disabled><br>
                </div>

                <div class="labeled-entry">
                    <label for="description-entry">description</label><br>
                    <textarea id="description-entry" rows="5" disabled>[[video_desc]]</textarea><br>
                </div>

                <div class="labeled-entry">
                    <label for="thumbnail-upload">thumbnail(max 5mib)</label><br>
                    <input id="thumbnail-upload" type="file" accept="image/*" capture="environment" /><br>
                </div>

                <div class="labeled-entry">
                    <label for="video-upload">video(max 2gib)</label><br>
                    <input id="video-upload" type="file" accept="video/*" capture="environment" /><br>
                </div>
                <div class="labeled-entry">
                    <label for="upload-progress">video upload progress</label>
                    <progress value="0" max="100" id="upload-progress"></progress>
                </div>
            </form>
        </div>
        <%view footer %>
        <script src="/upload.js"></script>
    </body>
</html>
