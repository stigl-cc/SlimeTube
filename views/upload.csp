<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>[[title]] - Account</title>
        <link rel="stylesheet" type="text/css" href="/styles.css">
        <link rel="stylesheet" type="text/css" href="/upload.css">
    </head>
    <body>
        <%view navbar %>
        <div class="create-upload-container">
            <div id="js-warning">Warning: This page requires javascript</div><br>
            <form class="create-upload-form">
                <div class="create-upload-text">Upload assets for video</div>

                <div class="labeled-entry">
                    <label for="id-entry">id</label><br>
                    <input id="id-entry" class="upload-disabled-entry" type="text" value="[[video_id]]" disabled><br>
                </div>

                <div class="labeled-entry">
                    <label for="title-entry">title</label><br>
                    <input id="title-entry" class="upload-disabled-entry" type="text" value="[[video_title]]" disabled><br>
                </div>

                <div class="labeled-entry">
                    <label for="thumbnail-upload">thumbnail(max 5mib)</label><br>
                    <input id="thumbnail-upload" type="file" accept="image/*" /><br>
                </div>

                <div class="labeled-entry">
                    <label for="video-upload">video(max 2gib)</label><br>
                    <input id="video-upload" type="file" accept="video/*" /><br>
                </div>
                <div class="labeled-entry">
                    <label for="upload-progress">video upload progress</label>
                    <progress value="0" max="100" id="upload-progress"></progress>
                </div>

                <input id="upload-submit" onclick="event.preventDefault(); uploadVideo('[[video_id]]');" type="submit" value="upload">
            </form>
        </div>
        <%view footer %>
        <script src="/upload.js"></script>
    </body>
</html>
